# Maintainer: Custom aria2 package builder
pkgname=aria2-custom-nobt
pkgver=${ARIA2_VERSION:?ARIA2_VERSION is required}
pkgrel=${BUILD_REVISION:?BUILD_REVISION is required}
pkgdesc='Custom aria2 command-line download utility for Arch Linux'
arch=('x86_64')
url='https://aria2.github.io/'
license=('GPL-2.0-or-later')
depends=('ca-certificates' 'openssl' 'c-ares' 'libssh2' 'sqlite' 'zlib' 'expat' 'gcc-libs')
makedepends=('cppunit' 'gettext' 'patch' 'pkgconf')
provides=('aria2')

case "${BITTORRENT:?BITTORRENT is required}" in
  yes)
    pkgname=aria2-custom-bt
    pkgdesc='Custom aria2 command-line download utility with BitTorrent support'
    _bittorrent_flag=--enable-bittorrent
    _expected_bittorrent=yes
    _conflict_pkg=aria2-custom-nobt
    ;;
  no)
    pkgname=aria2-custom-nobt
    pkgdesc='Custom aria2 command-line download utility without BitTorrent support'
    _bittorrent_flag=--disable-bittorrent
    _expected_bittorrent=no
    _conflict_pkg=aria2-custom-bt
    ;;
  *)
    error 'BITTORRENT must be yes or no'
    exit 1
    ;;
esac
conflicts=('aria2' "$_conflict_pkg")

_local_sha256() {
  sha256sum -- "$1" | cut -d ' ' -f1
}

source=(
  "aria2-${pkgver}.tar.gz"
  'unlimited-max-connection-per-server.patch'
  'openssl4-compat.patch'
  'build-linux-common.sh'
)
sha256sums=(
  "$(_local_sha256 "aria2-${pkgver}.tar.gz")"
  "$(_local_sha256 unlimited-max-connection-per-server.patch)"
  "$(_local_sha256 openssl4-compat.patch)"
  "$(_local_sha256 build-linux-common.sh)"
)

prepare() {
  local source_dir="$srcdir/aria2-$pkgver"
  source "$srcdir/build-linux-common.sh"
  aria2_linux_apply_connection_patch "$source_dir" "$srcdir/unlimited-max-connection-per-server.patch"
  patch --batch --forward --fuzz=0 -p1 -d "$source_dir" < "$srcdir/openssl4-compat.patch"
  touch "$source_dir/.aria2-custom-prepared"
}

build() {
  cd "$srcdir/aria2-$pkgver"
  source "$srcdir/build-linux-common.sh"
  aria2_linux_set_configure_args "$_bittorrent_flag"

  if [[ ! -f "$startdir/.aria2-configured" ]]; then
    aria2_linux_configure "$CPU_FLAGS" "$_expected_bittorrent" "$startdir/configure.log" "${ARIA2_CONFIGURE_ARGS[@]}"
    touch "$startdir/.aria2-configured"
  fi
  make -j"${BUILD_JOBS:-$(nproc)}"
}

check() {
  cd "$srcdir/aria2-$pkgver"
  if make -j"${BUILD_JOBS:-$(nproc)}" check; then
    return 0
  fi

  local test_log=test/test-suite.log
  local multicast_failures='^Test name: aria2::LpdMessage(ReceiverTest::testReceiveMessage|DispatcherTest::testSendMessage)$'
  if [[ -s "$test_log" ]] &&
    [[ "$(grep -Ec "$multicast_failures" "$test_log")" -eq 2 ]] &&
    [[ "$(grep -c '^Test name:' "$test_log")" -eq 2 ]] &&
    grep -Eq 'Failure total: 2[[:space:]]+Failures: 2[[:space:]]+Errors: 0' "$test_log"; then
    echo 'Skipping only the two LPD multicast integration checks: multicast packets are unavailable in this build environment.' >&2
    return 0
  fi

  echo 'Arch package tests failed; test/test-suite.log follows:' >&2
  if [[ -s "$test_log" ]]; then
    cat "$test_log" >&2
  else
    echo 'No test/test-suite.log was produced.' >&2
  fi
  return 1
}

package() {
  cd "$srcdir/aria2-$pkgver"
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  {
    printf 'aria2 upstream tag: %s\n' "$UPSTREAM_TAG"
    printf 'aria2 version: %s\n' "$pkgver"
    printf 'build revision: %s\n' "$pkgrel"
    printf 'target: Arch Linux x86-64-v3\n'
    printf 'cpu baseline: %s\n' "$CPU_FLAGS"
    printf 'bittorrent: %s\n' "$BITTORRENT"
    printf 'tls: OpenSSL\nlinkage: dynamic\n'
    printf 'patches: unlimited-max-connection-per-server.patch, openssl4-compat.patch\n'
    source "$srcdir/build-linux-common.sh"
    aria2_linux_set_configure_args "$_bittorrent_flag"
    printf 'configure: ./configure %s\n' "${ARIA2_CONFIGURE_ARGS[*]}"
  } > "$srcdir/BUILD-INFO.txt"
  install -Dm644 "$srcdir/BUILD-INFO.txt" "$pkgdir/usr/share/doc/$pkgname/BUILD-INFO.txt"
}
